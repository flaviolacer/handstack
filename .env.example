HANDSTACK_DEPLOYMENT_PROFILE=compact
HANDSTACK_DATABASE_ADAPTER=sqlite
HANDSTACK_DATABASE_URL=file:./handstack.db
HANDSTACK_API_PORT=3001
HANDSTACK_WEB_PORT=3000
HANDSTACK_LOG_LEVEL=info
HANDSTACK_TELEMETRY_ENABLED=false
# Optional OTLP/HTTP collector base URL. When telemetry is enabled, traces and metrics are sent to
# `${HANDSTACK_OTLP_ENDPOINT}/v1/{traces,metrics}`. Keep disabled or unset for local offline runs.
# HANDSTACK_OTLP_ENDPOINT=http://otel-collector:4318
# Generate independent random values with at least 32 characters for production.
HANDSTACK_ACCESS_TOKEN_SECRET=change-me-with-at-least-32-random-characters
HANDSTACK_TOKEN_PEPPER=change-me-with-another-32-random-characters
HANDSTACK_OIDC_STATE_PEPPER=change-me-with-a-third-32-random-character-value
# Distributed profile queue transport (required when HANDSTACK_DEPLOYMENT_PROFILE=distributed).
# HANDSTACK_REDIS_URL=redis://redis:6379/0
# Notification providers are opt-in; keep endpoints and credentials in a secret manager.
# HANDSTACK_NOTIFICATION_SLACK_ENDPOINT=https://hooks.slack.com/services/replace
# HANDSTACK_NOTIFICATION_TEAMS_ENDPOINT=https://example.webhook.office.com/replace
# HANDSTACK_NOTIFICATION_DISCORD_ENDPOINT=https://discord.com/api/webhooks/replace
# HANDSTACK_NOTIFICATION_SMTP_HOST=smtp.example.test
# HANDSTACK_NOTIFICATION_SMTP_PORT=587
# IdentityProvider secret references may resolve only HANDSTACK_SECRET_* variables.
# HANDSTACK_SECRET_CORPORATE_OIDC_CLIENT=replace-with-provider-client-secret
