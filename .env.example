HANDSTACK_DEPLOYMENT_PROFILE=compact
HANDSTACK_DATABASE_ADAPTER=sqlite
HANDSTACK_DATABASE_URL=file:./handstack.db
HANDSTACK_API_PORT=3001
HANDSTACK_WEB_PORT=3000
# Local attachment storage defaults; production deployments should use managed object storage.
# HANDSTACK_ATTACHMENT_STORAGE_PATH=.handstack-data/attachments
# HANDSTACK_ATTACHMENT_MAX_BYTES=26214400
# Optional comma-separated HTTPS webhook destination hosts; empty means no explicit allow-list.
# HANDSTACK_WEBHOOK_ALLOWED_HOSTS=hooks.example.test,webhooks.example.test
# Optional comma-separated HTTPS Knowledge source hosts; empty means no explicit hostname allow-list.
# HANDSTACK_KNOWLEDGE_ALLOWED_HOSTS=docs.example.test,www.googleapis.com
# HANDSTACK_PLUGIN_CACHE_DIR=.handstack-data/plugin-cache
# HANDSTACK_PLUGIN_ISOLATION_REQUIRED=false
# HANDSTACK_PLUGIN_TRUSTED_PUBLISHERS_JSON={"publisher-id":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----\\n"}
HANDSTACK_LOG_LEVEL=info
HANDSTACK_TELEMETRY_ENABLED=false
# HANDSTACK_OTLP_ENDPOINT=https://otel-collector:4318
# Internal API-to-worker authentication; use a random value of at least 32 characters in production.
HANDSTACK_INTERNAL_SERVICE_TOKEN=change-me-with-a-random-32-character-internal-token
# HANDSTACK_INTERNAL_API_KEY=change-me-with-a-provider-api-key
# HANDSTACK_GATEWAY_KEY_PEPPER=change-me-with-a-gateway-pepper
# HANDSTACK_SCIM_TOKEN_PEPPER=change-me-with-a-scim-pepper
# HANDSTACK_ATTACHMENT_SIGNING_SECRET=change-me-with-an-attachment-signing-secret
# Optional OTLP/HTTP collector base URL. When telemetry is enabled, traces and metrics are sent to
# `${HANDSTACK_OTLP_ENDPOINT}/v1/{traces,metrics}`. Keep disabled or unset for local offline runs.
# HANDSTACK_OTLP_ENDPOINT=http://otel-collector:4318
# Generate independent random values with at least 32 characters for production.
HANDSTACK_ACCESS_TOKEN_SECRET=change-me-with-at-least-32-random-characters
HANDSTACK_TOKEN_PEPPER=change-me-with-another-32-random-characters
HANDSTACK_OIDC_STATE_PEPPER=change-me-with-a-third-32-random-character-value
# 256-bit encryption master key (64 hex characters); generate a unique value for each environment.
HANDSTACK_MASTER_KEY=
# Temporary compatibility key only if webhook secrets were encrypted with the legacy provider.
# Remove after records have been read and lazily migrated to HANDSTACK_MASTER_KEY.
HANDSTACK_WEBHOOK_MASTER_KEY=
# External npm/GitHub plugins require isolated mode and an Ed25519 publisher signature.
# Configure a JSON object mapping publisher IDs to PEM public keys; keep artifact caches pre-provisioned.
# HANDSTACK_PLUGIN_TRUSTED_PUBLISHERS_JSON={"publisher-id":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----\\n"}
# Distributed profile queue transport (required when HANDSTACK_DEPLOYMENT_PROFILE=distributed).
# HANDSTACK_REDIS_URL=redis://redis:6379/0
# Idle time before a pending Redis Stream event can be reclaimed by another consumer (default 30s).
HANDSTACK_REDIS_STREAM_PENDING_CLAIM_IDLE_MS=30000
# HANDSTACK_REDIS_NAT_MAP={"redis-sentinel:26379":{"host":"redis.internal","port":26379}}
# Optional credential reference for configured external vector stores; resolve via the secret broker.
# HANDSTACK_VECTOR_STORE_CREDENTIAL_REFERENCE=secret://vector-store-api-key
# Conversation-retention scheduler is opt-in (sweeps at startup and on interval); each tenant uses
# a persisted lease so API replicas do not execute the same retention run concurrently.
HANDSTACK_PRIVACY_RETENTION_ENABLED=false
HANDSTACK_PRIVACY_RETENTION_INTERVAL_MS=86400000
# Tamper-evident audit verification scheduler is opt-in; each tenant uses a persisted lease.
# HANDSTACK_AUDIT_INTEGRITY_ENABLED=false
# HANDSTACK_AUDIT_INTEGRITY_INTERVAL_MS=86400000
# HANDSTACK_AUDIT_INTEGRITY_ORGANIZATIONS=org-a,org-b
# HANDSTACK_AUDIT_INTEGRITY_INSTANCE_ID=audit-integrity-a
# Knowledge source sync scheduler is opt-in; persistent tenant leases coordinate API replicas.
HANDSTACK_KNOWLEDGE_SYNC_ENABLED=false
HANDSTACK_KNOWLEDGE_SYNC_INTERVAL_MS=300000
# Optional comma-separated organization IDs; empty discovers active organizations from the database.
# HANDSTACK_KNOWLEDGE_SYNC_ORGANIZATIONS=org-a,org-b
# HANDSTACK_KNOWLEDGE_SYNC_INSTANCE_ID=knowledge-sync-a
# Workflow schedule dispatcher is opt-in; persistent tenant leases coordinate API replicas.
# HANDSTACK_WORKFLOW_SCHEDULER_ENABLED=false
# HANDSTACK_WORKFLOW_SCHEDULER_INTERVAL_MS=10000
# HANDSTACK_WORKFLOW_SCHEDULER_ORGANIZATIONS=org-a,org-b
# HANDSTACK_WORKFLOW_SCHEDULER_INSTANCE_ID=workflow-scheduler-a
# HANDSTACK_WORKFLOW_SCHEDULER_PRINCIPAL=scheduler
# Distributed worker operational defaults; queue-specific timeouts come from HANDSTACK_*_TIMEOUT_MS.
# HANDSTACK_WORKER_CONCURRENCY=1
# HANDSTACK_WORKER_TIMEOUT_MS=30000
# HANDSTACK_WORKER_HEARTBEAT_INTERVAL_MS=10000
# HANDSTACK_WORKER_MAX_ATTEMPTS=3
# HANDSTACK_WORKER_RETRY_JITTER_MS=250
# HANDSTACK_WORKER_METRICS_PORT=9091
# Notification providers are opt-in; keep endpoints and credentials in a secret manager.
# HANDSTACK_NOTIFICATION_SLACK_ENDPOINT=https://hooks.slack.com/services/replace
# HANDSTACK_NOTIFICATION_TEAMS_ENDPOINT=https://example.webhook.office.com/replace
# HANDSTACK_NOTIFICATION_DISCORD_ENDPOINT=https://discord.com/api/webhooks/replace
# HANDSTACK_NOTIFICATION_SMTP_HOST=smtp.example.test
# HANDSTACK_NOTIFICATION_SMTP_PORT=587
# IdentityProvider secret references may resolve only HANDSTACK_SECRET_* variables.
# HANDSTACK_SECRET_CORPORATE_OIDC_CLIENT=replace-with-provider-client-secret
